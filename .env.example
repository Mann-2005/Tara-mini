# Copy to .env and adjust if needed.
DATABASE_URL="postgresql://tara:tara@localhost:5433/tara_mini?schema=public"

# ─── Document classification (step 5): Google Gemini via the Vercel AI SDK ───
# Get a key at https://aistudio.google.com/apikey
#
# ⚠ DATA PROTECTION: on Google's FREE tier, prompts and files may be used to
# improve Google's products. A Steuerberater is bound by professional secrecy
# (§203 StGB, §57 StBerG) and the GDPR. Use the free tier ONLY with synthetic
# test documents (e.g. `pnpm samples`), never with real client documents.
# Real data needs a paid tier with a data processing agreement (AVV/DPA).
GOOGLE_GENERATIVE_AI_API_KEY=""

# Optional. Default: gemini-3.8-flash. (gemini-1.5-flash and gemini-2.0-flash are retired.)
GEMINI_MODEL=""

# Optional. Where uploaded originals are stored (default: ./storage).
STORAGE_DIR=""
